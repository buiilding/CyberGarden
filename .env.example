# Copy to .env.local; keep real values out of Git. Restart npm start after edits.
# Keep the same hostname and port you used for your existing IndexedDB pages.
APP_ORIGIN=http://localhost:4183
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact Google account email. No wildcards. Comma-separated if ever needed.
OWNER_EMAIL_ALLOWLIST=

# Separate Google Web application OAuth client for YouTube uploads.
# Redirect URI: APP_ORIGIN + /youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Cloudflare R2 image storage (server-only S3 credentials scoped to one bucket).
R2_ACCOUNT_ID=
R2_BUCKET_NAME=cybergarden-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# HTTPS custom image domain, or the bucket's public r2.dev URL for local review.
R2_PUBLIC_BASE_URL=

# Supabase Connect → Transaction pooler. Server-only, never NEXT_PUBLIC.
DATABASE_URL=
# Generate once with Fernet.generate_key(); keep stable across deploys.
SESSION_ENCRYPTION_KEY=
