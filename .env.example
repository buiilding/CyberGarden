# Copy to .env.local; keep real values out of Git. Restart npm start after edits.
# Keep the same hostname and port you used for your existing IndexedDB pages.
APP_ORIGIN=http://localhost:4183
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact Google account email. No wildcards. Comma-separated if ever needed.
OWNER_EMAIL_ALLOWLIST=
